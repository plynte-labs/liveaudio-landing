---
/**
 * FeatureBento — the "in the box" feature bento (Feature tiles / Bento on Home,
 * per the design system). Six released capabilities (per the product spec):
 *   hot-swap · FPS-aware profiles · hallucination blacklist · session files ·
 *   local-first diagnostics · in-app updates.
 * Mixed bento: `wide` tiles span 2 columns on a 4-col grid; the rest are 1-wide.
 * Each `.tile` = mono `.tile-kicker` (`// hot-swap`) + single emerald lucide
 * icon + Inter 600 title + body; hover border emerald + top accent line. All
 * copy via src/i18n/pages/home.ts. Answer-first H2; one `.section-glow`.
 *
 * Props: copy = HomeCopy["bento"].
 */
import type { BentoTile } from "../../i18n/pages/home";

interface Props {
  copy: {
    eyebrow: string;
    heading: string;
    tiles: BentoTile[];
  };
}

const { copy } = Astro.props;

// Inline lucide path data (stroke 1.75, 24px, currentColor) keyed by concept.
const ICON_PATHS: Record<BentoTile["icon"], string> = {
  repeat:
    '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
  gauge:
    '<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>',
  "shield-x":
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m14.5 9-5 5"/><path d="m9.5 9 5 5"/>',
  "file-text":
    '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  stethoscope:
    '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  "refresh-cw":
    '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
  captions:
    '<rect width="18" height="14" x="3" y="5" rx="2" ry="2"/><path d="M7 15h4M15 15h2M7 11h2M13 11h4"/>',
};
---

<section class="section section-glow bento" aria-labelledby="bento-h2">
  <div class="container">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="bento-h2" class="bento-heading">{copy.heading}</h2>

    <div class="bento-grid">
      {
        copy.tiles.map((tile) => (
          <article class={`tile bento-tile${tile.wide ? " is-wide" : ""}`}>
            <span class="bento-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={ICON_PATHS[tile.icon]}
              />
            </span>
            <p class="tile-kicker">
              {tile.kicker}
              {tile.badge && <span class="bento-badge">{tile.badge}</span>}
            </p>
            <h3 class="bento-title">{tile.title}</h3>
            <p class="bento-body">{tile.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .bento-heading {
    font-size: var(--text-2xl);
    margin: var(--space-3) 0 var(--space-8);
    max-width: var(--measure);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .bento-tile.is-wide {
      grid-column: span 2;
    }
  }

  .bento-tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    overflow: hidden;
  }
  /* Top accent line revealed on hover (no extra DOM). */
  .bento-tile::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--color-green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-mech);
  }
  .bento-tile:hover::before {
    transform: scaleX(1);
  }
  .bento-icon {
    color: var(--color-green);
    width: 24px;
    height: 24px;
  }
  /* Contextual pill ? mono, emerald, sits inline after the kicker. */
  .bento-badge {
    display: inline-block;
    margin-left: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-green);
    border-radius: var(--radius-sm);
    background: var(--color-green-faint);
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    vertical-align: middle;
  }
  .bento-title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0;
  }
  .bento-body {
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }
</style>
