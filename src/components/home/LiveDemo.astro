---
/**
 * LiveDemo — "Live Demo" section on `/` and `/es/`.
 *
 * Displays real native Rust + Tauri 2 desktop captures already bundled in
 * `public/media/liveaudio-v1.6.0/`:
 *   1. Setup Home (`v1-6-0-setup-home.webp`) — audio source, language, profile,
 *      live subtitles feed, and OBS Studio Browser Source URL.
 *   2. Style Editor (`v1-6-0-style-editor.webp`) — live preview and theme/preset
 *      controls for the 7 built-in OBS overlay themes.
 *
 * TODO (post-v1.6.5 tag): Drop in a fresh v1.6.5 NVIDIA Parakeet-TDT desktop
 * screenshot and/or silent WebM/MP4 loop under `public/media/liveaudio-v1.6.5/`
 * and update the image/video sources below once captured.
 *
 * Captions remain strictly honest about what the current captures show.
 * Zero React. Tokens/classes only. Props: lang.
 */
import type { Locale } from "../../i18n/routes";
import { homeCopy } from "../../i18n/pages/home";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const copy = homeCopy(lang).demo;
---

<section class="section section-glow demo" aria-labelledby="demo-h2">
  <div class="container">
    <header class="demo-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="demo-h2" class="demo-heading">{copy.heading}</h2>
      <p class="demo-lead">{copy.lead}</p>
    </header>

    <!-- Real-capture trust badge: neon live-dot = SIGNAL (real/live). -->
    <p class="pill demo-badge">
      <span class="live-dot" aria-hidden="true"></span>
      {copy.badge}
    </p>

    <!-- Native Rust + Tauri 2 desktop captures (setup home + 7-theme style editor).
         Replace with public/media/liveaudio-v1.6.5/ Parakeet capture or silent
         WebM/MP4 loop once v1.6.5 UI media is recorded. -->
    <div class="demo-grid">
      <figure class="console demo-frame">
        <img
          class="demo-image"
          src="/media/liveaudio-v1.6.0/v1-6-0-setup-home.webp"
          width="1917"
          height="1025"
          alt={copy.setupAlt}
          loading="lazy"
          decoding="async"
        />
        <figcaption class="demo-caption">{copy.setupCaption}</figcaption>
      </figure>

      <figure class="console demo-frame">
        <img
          class="demo-image"
          src="/media/liveaudio-v1.6.0/v1-6-0-style-editor.webp"
          width="977"
          height="850"
          alt={copy.styleAlt}
          loading="lazy"
          decoding="async"
        />
        <figcaption class="demo-caption">{copy.styleCaption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .demo-heading {
    font-size: var(--text-2xl);
    margin: var(--space-3) 0 var(--space-4);
    max-width: var(--measure);
  }
  .demo-lead {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.7;
    max-width: var(--measure);
    margin: 0 0 var(--space-4);
  }
  @media (min-width: 768px) {
    .demo-head {
      display: grid;
      grid-template-columns: 4fr 8fr;
      column-gap: var(--space-8);
    }
    .demo-head .eyebrow { grid-column: 1 / -1; }
    .demo-heading { grid-column: 1; }
    .demo-lead { grid-column: 2; align-self: end; }
  }
  .demo-badge {
    margin: 0 0 var(--space-7);
  }
  .demo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 1024px) {
    .demo-grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }
  }
  .demo-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: var(--color-surface-2);
  }
  .demo-frame {
    margin: 0;
    padding: var(--space-3);
    overflow: hidden;
  }
  .demo-caption {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding-inline: var(--space-1);
    line-height: 1.5;
  }
</style>
