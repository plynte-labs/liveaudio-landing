---
/**
 * LiveDemo — "Live Demo" section. Leads with the CURRENT v1.5.1 (Rust + Tauri 2)
 * product screenshot; the old screen recording stays below, explicitly badged
 * as the deprecated Python version until a Tauri video exists (trust signal
 * stays honest: current UI first, archive clearly labeled). Native
 * <video controls> for the archive — the browser's own player, so it always
 * works. The Hero owns the page <h1>; this section uses an <h2>. Zero React.
 * Tokens/classes only. Props: lang.
 */
import type { Locale } from "../../i18n/routes";
import { homeCopy } from "../../i18n/pages/home";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const copy = homeCopy(lang).demo;
---

<section class="section section-glow demo" aria-labelledby="demo-h2">
  <div class="container">
    <header class="demo-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="demo-h2" class="demo-heading">{copy.heading}</h2>
      <p class="demo-lead">{copy.lead}</p>
    </header>

    <!-- Real-capture trust badge: neon live-dot = SIGNAL (real/live), not amber. -->
    <p class="pill demo-badge">
      <span class="live-dot" aria-hidden="true"></span>
      {copy.badge}
    </p>

    <!-- Current v1.5.0 interface first (no Tauri video yet). -->
    <figure class="console demo-frame">
      <img
        class="demo-image"
        src="/media/liveaudio-v1.5.0/v1-5-0-avanzado.webp"
        width="1917"
        height="1013"
        alt={copy.imageAlt}
        loading="lazy"
        decoding="async"
      />
      <figcaption class="demo-caption">{copy.imageCaption}</figcaption>
    </figure>

    <!-- Archived recording: explicitly the deprecated Python version. -->
    <p class="pill pill-amber demo-legacy-badge">
      {copy.legacyBadge}
    </p>

    <!-- Native player in the hero console frame. Simple = robust. -->
    <figure class="console demo-frame demo-legacy">
      <video
        class="demo-video"
        poster="/demo/liveaudio-demo-poster.jpg"
        controls
        playsinline
        preload="metadata"
        aria-label={copy.videoAriaLabel}
      >
        <source src="/demo/liveaudio-demo.mp4" type="video/mp4" />
      </video>
      <figcaption class="demo-caption">{copy.legacyCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .demo-heading {
    font-size: var(--text-2xl);
    margin: var(--space-3) 0 var(--space-4);
    max-width: var(--measure);
  }
  .demo-lead {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.7;
    max-width: var(--measure);
    margin: 0 0 var(--space-4);
  }
  @media (min-width: 768px) {
    .demo-head {
      display: grid;
      grid-template-columns: 4fr 8fr;
      column-gap: var(--space-8);
    }
    .demo-head .eyebrow { grid-column: 1 / -1; }
    .demo-heading { grid-column: 1; }
    .demo-lead { grid-column: 2; align-self: end; }
  }
  .demo-badge {
    margin: 0 0 var(--space-7);
  }
  .demo-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: var(--color-surface-2);
  }
  .demo-legacy-badge {
    margin: var(--space-8) 0 var(--space-5);
  }
  .demo-legacy {
    opacity: 0.92;
  }
  /* Console frame around the video — reuses the hero `.console` treatment. */
  .demo-frame {
    margin: 0;
    padding: var(--space-3);
    overflow: hidden;
  }
  .demo-video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: var(--color-surface-2);
  }
  .demo-caption {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding-inline: var(--space-1);
  }
</style>
