---
/**
 * LiveDemo — "Live Demo" section. A REAL, unedited screen capture of LiveAudio
 * v1.2.0 (a trust signal vs the clearly-labeled "simulated" sandboxes). Kept
 * deliberately simple: a native <video controls autoplay muted loop> — the
 * browser's own player, so it always works. The Hero owns the page <h1>; this
 * section uses an <h2>. Zero React. Tokens/classes only. Props: lang.
 */
import type { Locale } from "../../i18n/routes";
import { homeCopy } from "../../i18n/pages/home";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const copy = homeCopy(lang).demo;
---

<section class="section section-glow demo" aria-labelledby="demo-h2">
  <div class="container">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="demo-h2" class="demo-heading">{copy.heading}</h2>
    <p class="demo-lead">{copy.lead}</p>

    <!-- Real-capture trust badge: neon live-dot = SIGNAL (real/live), not amber. -->
    <p class="pill demo-badge">
      <span class="live-dot" aria-hidden="true"></span>
      {copy.badge}
    </p>

    <!-- Native player in the hero console frame. Simple = robust. -->
    <figure class="console demo-frame">
      <video
        class="demo-video"
        poster="/demo/liveaudio-demo-poster.jpg"
        controls
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={copy.videoAriaLabel}
      >
        <source src="/demo/liveaudio-demo.mp4" type="video/mp4" />
      </video>
      <figcaption class="demo-caption">{copy.captionReal}</figcaption>
    </figure>
  </div>
</section>

<style>
  .demo-heading {
    font-size: var(--text-2xl);
    margin: var(--space-3) 0 var(--space-4);
    max-width: var(--measure);
  }
  .demo-lead {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.7;
    max-width: var(--measure);
    margin: 0 0 var(--space-4);
  }
  .demo-badge {
    margin: 0 0 var(--space-7);
  }
  /* Console frame around the video — reuses the hero `.console` treatment. */
  .demo-frame {
    margin: 0;
    padding: var(--space-3);
    overflow: hidden;
  }
  .demo-video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: var(--color-surface-2);
  }
  .demo-caption {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding-inline: var(--space-1);
  }
</style>
