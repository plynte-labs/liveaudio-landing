---
/** A compact decision path to the next useful product page. */
interface Props {
  copy: {
    eyebrow: string;
    heading: string;
    lead: string;
    tour: { title: string; body: string; cta: string };
    start: { title: string; body: string; cta: string };
    obs: { title: string; body: string; cta: string; docs: string };
  };
  productTourHref: string;
  gettingStartedHref: string;
  obsSetupHref: string;
  docsHref: string;
}

const { copy, productTourHref, gettingStartedHref, obsSetupHref, docsHref } = Astro.props;
---

<section class="section paths" aria-labelledby="paths-h2">
  <div class="container">
    <header class="paths-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="paths-h2">{copy.heading}</h2>
      <p>{copy.lead}</p>
    </header>

    <div class="paths-list">
      <article class="path-item">
        <span class="path-index">01</span>
        <div><h3>{copy.tour.title}</h3><p>{copy.tour.body}</p></div>
        <a class="btn-tertiary" href={productTourHref}>{copy.tour.cta} <span aria-hidden="true">→</span></a>
      </article>
      <article class="path-item">
        <span class="path-index">02</span>
        <div><h3>{copy.start.title}</h3><p>{copy.start.body}</p></div>
        <a class="btn-tertiary" href={gettingStartedHref}>{copy.start.cta} <span aria-hidden="true">→</span></a>
      </article>
      <article class="path-item">
        <span class="path-index">03</span>
        <div><h3>{copy.obs.title}</h3><p>{copy.obs.body}</p></div>
        <span class="path-actions"><a class="btn-tertiary" href={obsSetupHref}>{copy.obs.cta} <span aria-hidden="true">→</span></a><a class="path-docs" href={docsHref}>{copy.obs.docs}</a></span>
      </article>
    </div>
  </div>
</section>

<style>
  .paths-head { display: grid; gap: var(--space-3); margin-bottom: var(--space-8); }
  .paths-head h2 { margin: 0; font-size: var(--text-2xl); }
  .paths-head > p:last-child { margin: 0; color: var(--color-text-muted); max-width: 62ch; }
  .paths-list { border-top: 1px solid var(--color-border); }
  .path-item { display: grid; gap: var(--space-4); padding: var(--space-6) 0; border-bottom: 1px solid var(--color-border); }
  .path-index { color: var(--color-green); font-family: var(--font-mono); font-size: var(--text-xs); }
  .path-item h3 { margin: 0 0 var(--space-2); font-size: var(--text-xl); }
  .path-item p { margin: 0; color: var(--color-text-muted); max-width: 58ch; }
  .path-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
  .path-docs { font-family: var(--font-mono); font-size: var(--text-xs); }
  @media (min-width: 768px) {
    .paths-head { grid-template-columns: 4fr 8fr; column-gap: var(--space-8); }
    .paths-head .eyebrow { grid-column: 1 / -1; }
    .paths-head h2 { grid-column: 1; }
    .paths-head > p:last-child { grid-column: 2; }
    .path-item { grid-template-columns: 1fr minmax(0, 5fr) minmax(180px, 2fr); align-items: center; }
  }
</style>
