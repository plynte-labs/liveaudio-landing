---
/**
 * MobileNav (NO-REACT) — full-height drawer over a SOLID surface (not blur),
 * per the design system. Vanilla replacement for the former React island so
 * pure-content pages (docs/faq) ship ZERO React runtime.
 *
 * Structure: a real <button> trigger + a role="dialog" drawer rendered in the
 * static HTML (hidden by default). A tiny inline vanilla <script> wires the
 * exact a11y contract the audit praised:
 *   - 48px min tap targets.
 *   - Focus moves into the drawer on open (close button) + trapped (Tab/Shift+Tab cycle).
 *   - `inert` on every subtree outside the drawer while open (including <header>),
 *     so the background — desktop nav, brand, lang toggle — is not focusable.
 *   - Esc closes; closes on any nav-link click (route change).
 *   - Focus returns to the trigger on close.
 *   - aria-expanded / aria-controls wired to the trigger; aria-modal dialog.
 *
 * Props mirror the previous React island so Header.astro rewires with no copy
 * changes; all values are already localized by the caller.
 */

export interface MobileNavLink {
  href: string;
  label: string;
}

interface Props {
  links: MobileNavLink[];
  downloadHref: string;
  downloadLabel: string;
  githubHref: string;
  githubLabel: string;
  altHref: string;
  altLabel: string;
  openLabel: string;
  closeLabel: string;
}

const {
  links,
  downloadHref,
  downloadLabel,
  githubHref,
  githubLabel,
  altHref,
  altLabel,
  openLabel,
  closeLabel,
} = Astro.props;
---

<div class="mobilenav" data-mobilenav>
  <button
    type="button"
    class="btn btn-secondary mobilenav-trigger"
    data-mobilenav-trigger
    aria-expanded="false"
    aria-controls="mobile-drawer"
    aria-label={openLabel}
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>

  <div
    id="mobile-drawer"
    class="mobilenav-drawer"
    data-mobilenav-drawer
    role="dialog"
    aria-modal="true"
    aria-label={openLabel}
    hidden
  >
    <div class="mobilenav-head container">
      <a
        class="btn btn-primary mobilenav-download"
        href={downloadHref}
        data-mobilenav-link
      >
        {downloadLabel}
      </a>
      <button
        type="button"
        class="btn btn-secondary mobilenav-close"
        data-mobilenav-close
        aria-label={closeLabel}
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="mobilenav-links container" aria-label="Mobile">
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a
                class="mobilenav-link"
                href={link.href}
                data-mobilenav-link
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mobilenav-meta">
        <a
          class="mobilenav-link mobilenav-meta-link"
          href={githubHref}
          target="_blank"
          rel="noopener noreferrer"
          data-mobilenav-link
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.32.47-2.39 1.24-3.23-.13-.3-.54-1.53.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.05.14 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.29 0 .32.21.7.82.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"
            ></path>
          </svg>
          {githubLabel}
        </a>
        <a
          class="mobilenav-link mobilenav-meta-link"
          href={altHref}
          data-mobilenav-link
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m5 8 6 6"></path>
            <path d="m4 14 6-6 2-3"></path>
            <path d="M2 5h12"></path>
            <path d="M7 2h1"></path>
            <path d="m22 22-5-10-5 10"></path>
            <path d="M14 18h6"></path>
          </svg>
          {altLabel}
        </a>
      </div>
    </nav>
  </div>
</div>

<style>
  .mobilenav-trigger {
    padding-inline: 0;
    width: 48px;
    aspect-ratio: 1;
    justify-content: center;
    color: var(--color-text);
  }
  .mobilenav-drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    animation: reveal 180ms var(--ease-mech) both;
    /* Match the header's "signal in" top hairline so the drawer reads as the
       same instrument expanded. Faint token only — NO glow. */
    box-shadow: inset 0 1px 0 var(--color-green-faint);
  }
  .mobilenav-drawer[hidden] {
    display: none;
  }
  .mobilenav-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
    border-bottom: 1px solid var(--color-border-soft);
  }
  .mobilenav-download {
    flex: 1;
    min-height: 48px;
    justify-content: center;
  }
  .mobilenav-close {
    padding-inline: 0;
    width: 48px;
    aspect-ratio: 1;
    justify-content: center;
    color: var(--color-text);
  }
  .mobilenav-links {
    padding-block: var(--space-7);
  }
  .mobilenav-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .mobilenav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding-inline: var(--space-3);
    /* a mono "channel index" caret precedes each row, lit on hover/focus */
    font-family: var(--font-mono);
    font-size: var(--text-base);
    text-transform: lowercase;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border-soft);
    transition:
      color 120ms var(--ease-mech),
      background 120ms var(--ease-mech);
  }
  /* Lit selection channel: a 2px emerald bar on the leading edge, scaled in
     on hover/focus — mirrors the desktop active-link language. */
  .mobilenav-link::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    height: 24px;
    width: 2px;
    border-radius: 1px;
    background: var(--color-green);
    transform: translateY(-50%) scaleY(0);
    transform-origin: center;
    transition: transform 140ms var(--ease-mech);
  }
  .mobilenav-link:hover,
  .mobilenav-link:focus-visible {
    color: var(--color-green);
    background: var(--color-green-faint);
    text-decoration: none;
  }
  .mobilenav-link:hover::before,
  .mobilenav-link:focus-visible::before {
    transform: translateY(-50%) scaleY(1);
  }
  .mobilenav-meta {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-6);
    /* set the secondary cluster apart from the primary link list */
    border-top: 1px solid var(--color-border-soft);
    padding-top: var(--space-2);
  }
  .mobilenav-meta-link {
    color: var(--color-text-muted);
    text-transform: none;
  }
  .mobilenav-meta-link:hover,
  .mobilenav-meta-link:focus-visible {
    color: var(--color-green);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobilenav-link,
    .mobilenav-link::before {
      transition: none;
    }
  }
</style>

<script>
  // Vanilla a11y controller for the mobile drawer. One controller per
  // [data-mobilenav] root so multiple headers (defensive) stay independent.
  const FOCUSABLE =
    'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

  function setupMobileNav(root: HTMLElement) {
    const trigger = root.querySelector<HTMLButtonElement>(
      "[data-mobilenav-trigger]",
    );
    const drawer = root.querySelector<HTMLElement>("[data-mobilenav-drawer]");
    const closeBtn = root.querySelector<HTMLButtonElement>(
      "[data-mobilenav-close]",
    );
    if (!trigger || !drawer || !closeBtn) return;

    let open = false;
    let inerted: Element[] = [];

    const focusableInDrawer = () =>
      Array.from(drawer.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (el) => el.offsetParent !== null,
      );

    function onKeyDown(e: KeyboardEvent) {
      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== "Tab") return;
      const items = focusableInDrawer();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function openDrawer() {
      if (open) return;
      open = true;
      drawer!.hidden = false;
      trigger!.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = "hidden";

      // Inert every subtree outside the drawer's ancestor chain — walk up from
      // the drawer to <body>, inerting all siblings that don't contain it. This
      // makes the rest of the page (including <header>) non-focusable/aria-hidden
      // while the drawer is open, exactly like the prior React behavior.
      inerted = [];
      let node: Node | null = drawer;
      while (node && node !== document.body && node.parentElement) {
        const parent = node.parentElement;
        for (const sibling of Array.from(parent.children)) {
          if (sibling !== node && !sibling.contains(drawer)) {
            sibling.setAttribute("inert", "");
            sibling.setAttribute("aria-hidden", "true");
            inerted.push(sibling);
          }
        }
        node = parent;
      }

      document.addEventListener("keydown", onKeyDown);
      // Move focus into the drawer.
      closeBtn!.focus();
    }

    function close() {
      if (!open) return;
      open = false;
      drawer!.hidden = true;
      trigger!.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
      inerted.forEach((el) => {
        el.removeAttribute("inert");
        el.removeAttribute("aria-hidden");
      });
      inerted = [];
      document.removeEventListener("keydown", onKeyDown);
      // Restore focus to the trigger.
      trigger!.focus();
    }

    trigger.addEventListener("click", openDrawer);
    closeBtn.addEventListener("click", close);
    // Close on any nav-link click (route change) — the link still navigates.
    root.querySelectorAll<HTMLAnchorElement>("[data-mobilenav-link]").forEach(
      (link) => link.addEventListener("click", close),
    );
  }

  document
    .querySelectorAll<HTMLElement>("[data-mobilenav]")
    .forEach(setupMobileNav);
</script>
