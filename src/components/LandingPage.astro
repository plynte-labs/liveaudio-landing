---
/**
 * LandingPage — the full Home funnel (EN at `/`, ES mirror at `/es/`).
 *
 * Composes the conversion funnel in the exact design system (`/`) order:
 *   Static product-proof hero (owns the page's single <h1>)
 *   → Trust strip
 *   → real demo
 *   → 3 objection-killer cards (100% local / Linux / GPU)
 *   → compact signal path + docs link
 *   → route chooser
 *   → closing full-width Download module.
 *
 * Every claim is traceable to the product spec via src/i18n/pages/home.ts. The Home
 * carries SoftwareApplication + FAQPage JSON-LD (§10) through Layout's jsonLd.
 * Marketing page → docked transport bar (transport defaults true). Exactly one
 * <h1> (in HeroProductProof); every section opens answer-first with a mono eyebrow
 * + H2.
 *
 * Props: lang.
 */
import Layout from "../layouts/Layout.astro";
import HeroProductProof from "./home/HeroProductProof.astro";
import TrustStrip from "./home/TrustStrip.astro";
import ObjectionCards from "./home/ObjectionCards.astro";
import Pipeline from "./home/Pipeline.astro";
import LiveDemo from "./home/LiveDemo.astro";
import HomePathChooser from "./home/HomePathChooser.astro";
import ClosingDownload from "./home/ClosingDownload.astro";

import { localizedPath, type Locale } from "../i18n/routes";
import { homeCopy } from "../i18n/pages/home";
import {
  softwareApplication,
  faqPage,
  organizationWebSite,
} from "../i18n/jsonld";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const copy = homeCopy(lang);

const path = localizedPath(lang, "");
const downloadHref = localizedPath(lang, "download");
const gettingStartedHref = localizedPath(lang, "getting-started");
const docsHref = localizedPath(lang, "docs/overview");
const productTourHref = localizedPath(lang, "product-tour");
const obsSetupHref = localizedPath(lang, "obs-setup");

// JSON-LD: SoftwareApplication + FAQPage + WebSite (Home, §10). The FAQPage is
// built from the site FAQ source. Filter null nodes (faqPage returns null on an
// empty list) before handing to Layout.
const jsonLd = [
  softwareApplication({ lang }),
  faqPage(copy.faqTeaser.items),
  organizationWebSite(),
].filter((node): node is Record<string, unknown> => node !== null);
---

<Layout
  title={copy.meta.title}
  description={copy.meta.description}
  lang={lang}
  path={path}
  jsonLd={jsonLd}
  transport={true}
>
  <!-- 1 · Static product proof (owns the page's single <h1>) -->
  <HeroProductProof
    copy={copy.hero}
    downloadHref={downloadHref}
    gettingStartedHref={gettingStartedHref}
  />

  <!-- 2 · Trust strip -->
  <TrustStrip items={copy.trust.items} label={copy.trust.label} />

  <!-- 3 · Live demo -->
  <LiveDemo lang={lang} />

  <!-- 4 · Objection-killer cards (100% local / Linux / GPU) -->
  <ObjectionCards copy={copy.objections} />

  <!-- 5 · Compact signal path -->
  <Pipeline copy={copy.pipeline} docsHref={docsHref} />

  <!-- 6 · Route chooser -->
  <HomePathChooser
    copy={copy.paths}
    productTourHref={productTourHref}
    gettingStartedHref={gettingStartedHref}
    obsSetupHref={obsSetupHref}
    docsHref={docsHref}
  />

  <!-- 7 · Closing full-width Download module -->
  <ClosingDownload
    copy={copy.closing}
    downloadHref={downloadHref}
    secondaryHref={gettingStartedHref}
  />
</Layout>
