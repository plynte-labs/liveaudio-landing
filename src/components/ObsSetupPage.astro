---
/**
 * ObsSetupPage — /obs-setup/ body (EN at /obs-setup/, ES mirror at /es/obs-setup/).
 *
 * The highest-intent, CITABLE HowTo page. It answers one question with the real,
 * verbatim OBS Browser-source flow (see src/i18n/pages/obs-setup.ts).
 *
 * Page shape: H1 + plain lead → download band → visual walkthrough (prominent
 * overlay-URL block + step cards: what to click, what you should see; the original
 * detail and pills are collapsed per card) → collapsed Technical details (signal
 * path diagram + WebSocket payload table) → Download module → help band.
 *
 * JSON-LD: HowTo (built 1:1 from the SAME steps array the cards render, so the
 * structured data can never drift from the visible copy) + SoftwareApplication +
 * WebSite. Colors are tokens only; amber appears ONLY in the warn/verify/timing
 * semantic.
 *
 * Props: lang.
 */
import Layout from "../layouts/Layout.astro";
import Button from "./Button.astro";
import WsDiagram from "./WsDiagram.astro";
import CtaBand from "./visual/CtaBand.astro";
import TechDetails from "./visual/TechDetails.astro";
import { localizedPath, type Locale } from "../i18n/routes";
import { obsSetupCopy } from "../i18n/pages/obs-setup";
import { howTo, softwareApplication, organizationWebSite } from "../i18n/jsonld";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const path = localizedPath(lang, "obs-setup");
const downloadHref = localizedPath(lang, "download");

const copy = obsSetupCopy(lang);

/** Zero-padded mono step numeral ("01".."05"). */
function stepNum(i: number): string {
  return String(i + 1).padStart(2, "0");
}

// JSON-LD: HowTo built from the SAME steps that render the cards (name + text),
// plus SoftwareApplication + WebSite. howTo() returns null on empty input.
const jsonLd = [
  howTo({
    name: copy.howToName,
    steps: copy.steps.map((step) => ({ name: step.name, text: step.text })),
  }),
  softwareApplication({ lang }),
  organizationWebSite(),
].filter((node): node is Record<string, unknown> => node !== null);
---

<Layout
  title={copy.title}
  description={copy.description}
  lang={lang}
  path={path}
  jsonLd={jsonLd}
  transport={true}
>
  <!-- 1 · What it is: single H1 + plain-language lead -->
  <section class="section section-glow" aria-labelledby="obs-h1">
    <div class="container obs-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 id="obs-h1" class="obs-title">{copy.h1}</h1>
      <p class="obs-intro">{copy.introPlain}</p>
    </div>
  </section>

  <!-- 2 · Need the app first? -->
  <CtaBand lang={lang} kind="download" />

  <!-- 3 · Visual walkthrough: number, what to click, what you should see -->
  <section class="section section-alt" aria-labelledby="obs-steps-h2">
    <div class="container">
      <p class="eyebrow">{copy.stepsEyebrow}</p>
      <h2 id="obs-steps-h2" class="obs-section-heading">{copy.stepsHeading}</h2>

      <div class="obs-url">
        <p class="obs-url-label">{copy.url.label}</p>
        <div class="code-block">
          <div class="obs-url-row">
            <code class="obs-url-value" id="obs-url-value">{copy.url.value}</code>
            <button
              type="button"
              class="btn btn-secondary obs-url-copy"
              data-copy-target="obs-url-value"
              data-copy-label={copy.url.copy}
              data-copied-label={copy.url.copied}
            >{copy.url.copy}</button>
          </div>
        </div>
        <p class="obs-url-hint">{copy.url.hint}</p>
      </div>

      <ol class="obs-steps">
        {
          copy.steps.map((step, i) => (
            <li class="obs-step card">
              <div class="obs-step-num mono" aria-hidden="true">
                {stepNum(i)}
              </div>
              <div class="obs-step-body">
                <h3 class="obs-step-name">{step.name}</h3>
                <p class="obs-step-short">{step.short}</p>
                <p class="obs-step-see">
                  <svg class="obs-eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                  <span><strong>{copy.seeLabel}:</strong> {step.see}</span>
                </p>
                <TechDetails lang={lang} summary={copy.moreDetail}>
                  <p class="tile-kicker">{step.kicker}</p>
                  <p class="obs-step-text">{step.text}</p>
                  {(step.token || step.amber) && (
                    <p class="obs-step-meta">
                      {step.token && <span class="pill">{step.token}</span>}
                      {step.amber && <span class="pill pill-amber">{step.amber}</span>}
                    </p>
                  )}
                </TechDetails>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4 · Technical details (collapsed): how it works + signal path + payload -->
  <section class="section" aria-labelledby="obs-tech-h2">
    <div class="container obs-diagram-wrap">
      <p class="eyebrow">{copy.techEyebrow}</p>
      <h2 id="obs-tech-h2" class="obs-section-heading">{copy.techHeading}</h2>

      <TechDetails lang={lang}>
        <p class="obs-diagram-body">{copy.intro}</p>

        <h3 class="obs-sub-heading">{copy.diagramHeading}</h3>
        <p class="obs-diagram-body">{copy.diagramBody}</p>
        <WsDiagram
          liveaudio={copy.diagram.liveaudio}
          obs={copy.diagram.obs}
          client={copy.diagram.client}
          signal={copy.diagram.signal}
          caption={copy.diagram.caption}
          ariaLabel={copy.diagramHeading}
          class="obs-diagram"
        />

        <h3 class="obs-sub-heading obs-sub-gap">{copy.payloadHeading}</h3>
        <p class="obs-payload-intro">{copy.payloadIntro}</p>

        <div class="obs-payload-scroll">
          <table class="vs-table obs-payload-table">
            <caption class="obs-sr-only">{copy.payloadIntro}</caption>
            <thead>
              <tr>
                <th scope="col">{copy.payloadColField}</th>
                <th scope="col">{copy.payloadColDesc}</th>
              </tr>
            </thead>
            <tbody>
              {
                copy.payloadFields.map((row) => (
                  <tr>
                    <th scope="row" class="obs-payload-field">
                      {row.field}
                    </th>
                    <td
                      class:list={[
                        "obs-payload-desc",
                        { "obs-payload-timing": row.timing },
                      ]}
                    >
                      {row.desc}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="obs-payload-note">
          <span class="sim-label">{copy.payloadNote}</span>
        </p>
      </TechDetails>
    </div>
  </section>

  <!-- 5 · Download -->
  <section class="section section-alt section-glow" aria-labelledby="obs-closing-h2">
    <div class="container obs-closing">
      <p class="eyebrow">{copy.closingEyebrow}</p>
      <h2 id="obs-closing-h2" class="obs-closing-heading">
        {copy.closingHeading}
      </h2>
      <p class="obs-closing-body">{copy.closingBody}</p>
      <Button variant="primary" href={downloadHref} label={copy.download} />
    </div>
  </section>

  <!-- 6 · Help -->
  <CtaBand lang={lang} kind="help" />
</Layout>

<script>
  // Copy the overlay URL. The text is also user-select: all, so it works without JS.
  document.querySelectorAll<HTMLButtonElement>("[data-copy-target]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const el = document.getElementById(btn.dataset.copyTarget ?? "");
      if (!el?.textContent) return;
      try {
        await navigator.clipboard.writeText(el.textContent.trim());
        btn.textContent = btn.dataset.copiedLabel ?? "";
        setTimeout(() => {
          btn.textContent = btn.dataset.copyLabel ?? "";
        }, 2000);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(el);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    });
  });
</script>

<style>
  /* Screen-reader-only utility (visually hidden, still announced). */
  .obs-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .obs-head { max-width: var(--measure); }
  .obs-title { font-size: var(--text-3xl); margin: var(--space-3) 0 var(--space-4); }
  .obs-intro { color: var(--color-text); font-size: var(--text-lg); margin: 0; overflow-wrap: anywhere; }

  .obs-section-heading { font-size: var(--text-2xl); margin: var(--space-3) 0 var(--space-6); max-width: var(--measure); }
  .obs-sub-heading { font-size: var(--text-xl); margin: var(--space-6) 0 var(--space-3); }
  .obs-sub-gap { margin-top: var(--space-9); }

  /* Prominent, copy-friendly overlay URL */
  .obs-url { margin-bottom: var(--space-9); }
  .obs-url-label { margin: 0 0 var(--space-3); font-weight: 600; color: var(--color-text-strong); }
  .obs-url-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); padding: var(--space-5); }
  .obs-url-value {
    flex: 1 1 16rem;
    min-width: 0;
    color: var(--color-green);
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
    user-select: all;
  }
  .obs-url-hint { margin: var(--space-3) 0 0; color: var(--color-text-muted); font-size: var(--text-sm); }

  /* Step cards */
  .obs-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-6); }
  .obs-step {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-7);
  }
  .obs-step-num {
    width: 3rem;
    height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-lg);
    color: var(--color-green);
    background: var(--color-green-faint);
    border: 1px solid var(--color-green);
    border-radius: var(--radius-sm);
  }
  .obs-step-body { min-width: 0; display: grid; gap: var(--space-3); }
  .obs-step-name { font-size: var(--text-lg); line-height: 1.3; margin: 0; }
  .obs-step-short { margin: 0; overflow-wrap: anywhere; }
  .obs-step-see {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-green-faint);
    font-size: var(--text-sm);
  }
  .obs-eye { color: var(--color-green); flex-shrink: 0; margin-top: 2px; }
  .obs-step-text { margin: var(--space-2) 0 0; max-width: var(--measure); overflow-wrap: anywhere; }
  .obs-step-meta { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0 0; max-width: none; }
  .obs-step-meta .pill { text-transform: none; }

  @media (max-width: 640px) {
    .obs-step { grid-template-columns: minmax(0, 1fr); padding: var(--space-5); gap: var(--space-3); }
    .obs-step-num { width: 2.5rem; height: 2.5rem; }
  }

  /* Technical details content */
  .obs-diagram-wrap { max-width: 920px; }
  .obs-diagram-body { color: var(--color-text); margin: 0 0 var(--space-6); max-width: var(--measure); overflow-wrap: anywhere; }
  .obs-payload-intro { color: var(--color-text); margin: 0 0 var(--space-6); max-width: var(--measure); }
  .obs-payload-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    -webkit-overflow-scrolling: touch;
  }
  .obs-payload-table { min-width: 32rem; }
  .obs-payload-field { color: var(--color-green); font-weight: 500; text-transform: none; white-space: nowrap; }
  .obs-payload-desc { color: var(--color-text); text-transform: none; white-space: normal; }
  .obs-payload-timing { color: var(--color-amber); }
  .obs-payload-note { margin: var(--space-5) 0 0; max-width: var(--measure); }
  .obs-payload-note .sim-label { line-height: 1.6; }

  /* Closing module */
  .obs-closing-heading { font-size: var(--text-2xl); margin: var(--space-3) 0 var(--space-4); max-width: var(--measure); }
  .obs-closing-body { color: var(--color-text); margin: 0 0 var(--space-6); max-width: var(--measure); }
</style>
